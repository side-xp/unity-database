/* Styles of the Database window. Class names use the "database-" prefix, BEM style (block__element). */

.database-page {
    flex-grow: 1;
}

.database-table-view {
    flex-grow: 1;
}

.database-table-view__list {
    flex-grow: 1;
}

/* The message takes the place of the list, so the status line stays at the bottom */
.database-table-view > .database-message {
    flex-grow: 1;
}

.database-table-view__header {
    -unity-text-align: middle-left;
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-grow: 1;
}

/* The container of the display created by the cell handler */
.database-table-view__cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
}

/* Public class: CellHandler.DisplayLabelClass, also used by the custom handlers */
.database-cell__label {
    -unity-text-align: middle-left;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
}

.database-cell__toggle {
    margin-left: 0;
    margin-right: 0;
}

.database-cell__swatch {
    flex-grow: 1;
    height: 14px;
    justify-content: flex-end;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.4);
}

.database-cell__swatch-alpha {
    height: 2px;
    background-color: white;
}

.database-cell__reference {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.database-cell__reference-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 2px;
}

.database-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

/* A translucent border works with both the light and the dark editor themes */
.database-status-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 20px;
    padding-left: 6px;
    padding-right: 6px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.3);
}

.database-status-bar__label {
    -unity-text-align: middle-left;
    opacity: 0.8;
}

.database-toolbar__search {
    flex-grow: 1;
    width: auto;
}

.database-toolbar__title {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-left: 6px;
}

.database-obsolete-mark {
    -unity-text-align: middle-left;
    margin-left: 4px;
}

.database-table-list {
    flex-grow: 1;
}

.database-table-list__item {
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
}

.database-table-list__name {
    -unity-text-align: middle-left;
}

.database-message {
    -unity-text-align: middle-center;
    white-space: normal;
    opacity: 0.6;
    margin: 12px;
}
