/* Styles of the Database window. Class names use the "database-" prefix, BEM style (block__element). */

.database-page {
    flex-grow: 1;
}

/* Holds the table view and the view panel, side by side under the toolbar */
.database-page__content {
    flex-direction: row;
    flex-grow: 1;
}

/* The panel of the view (ViewPanel), on the right of the table. A translucent border works with both editor themes. Temporary look,
   until the style pass */
.database-view-panel {
    width: 320px;
    min-width: 220px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.4);
}

.database-view-panel__content {
    flex-grow: 1;
}

.database-view-panel__section {
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 8px;
}

.database-view-panel__section-header {
    flex-direction: row;
    align-items: center;
    height: 26px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.25);
}

/* Grows, so the buttons of the section are on the right */
.database-view-panel__section-title {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    font-size: 13px;
    padding-left: 0;
    margin-left: 0;
}

/* Between the title (and its mark) and the other elements of the header of a section, so they're on the right */
.database-view-panel__section-spacer {
    flex-grow: 1;
}

/* After the title of a section whose setting is overridden in a project view (ViewPanel) */
.database-view-panel__override-mark {
    --sxp-icon-size: 14;
    margin-left: 2px;
    opacity: 0.6;
}

/* The list of the overrides of a project view, under its name in the View section (ViewPanel) */
.database-view-panel__overrides {
    margin-top: 6px;
}

.database-view-panel__overrides-title {
    -unity-font-style: bold;
    font-size: 11px;
    opacity: 0.6;
    padding-left: 0;
    margin-left: 0;
    margin-bottom: 2px;
}

.database-view-panel__override {
    flex-direction: row;
    align-items: center;
    height: 20px;
}

.database-view-panel__override-text {
    flex-grow: 1;
    -unity-text-align: middle-left;
    padding-left: 0;
    margin-left: 0;
}

.database-view-panel__override-reset {
    flex-shrink: 0;
    padding-left: 1px;
    padding-right: 1px;
    margin-right: 0;
}

.database-view-panel__override-reset > .sxp-icon {
    --sxp-icon-size: 14;
}

.database-view-panel__override-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.database-view-panel__section-button {
    margin-right: 0;
}

/* The status of the open view, on the right of the title of the View section (ViewPanel): faded, so it informs without competing
   with the title */
.database-view-panel__view-status {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    opacity: 0.6;
}

.database-view-panel__view-status-icon {
    --sxp-icon-size: 14;
    flex-shrink: 0;
}

.database-view-panel__view-status-label {
    -unity-text-align: middle-left;
    font-size: 11px;
    margin-left: 3px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* A group of the filter editor (FilterEditor). The groups inside another group are indented, with a line on their left */
.database-filter-group {
    margin-top: 2px;
    margin-bottom: 2px;
}

.database-filter-group .database-filter-group {
    margin-left: 4px;
    padding-left: 6px;
    border-left-width: 2px;
    border-left-color: rgba(128, 128, 128, 0.4);
}

.database-filter-group__header {
    flex-direction: row;
    align-items: center;
}

/* Grows, so the remove button of the group is on the right */
.database-filter-group__operator {
    flex-grow: 1;
    margin-left: 0;
}

.database-filter-group__footer {
    flex-direction: row;
    margin-top: 2px;
}

.database-filter-group__footer > .database-filter-editor__add {
    margin-left: 0;
    margin-right: 4px;
}

.database-filter-group__empty,
.database-filter-condition__ignored {
    -unity-font-style: italic;
    white-space: normal;
    opacity: 0.6;
    padding-top: 2px;
    padding-bottom: 2px;
}

/* A condition: its column, its fields, then the remove button */
.database-filter-condition {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.database-filter-condition__column {
    width: 35%;
    flex-shrink: 0;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 0;
}

/* A condition on a column that doesn't exist anymore. Orange like the warnings of the console, readable with both editor themes */
.database-filter-condition__column--missing {
    color: rgb(230, 150, 40);
}

.database-filter-condition__field,
.database-filter-condition__ignored {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
}

/* A number range: the minimum, "to", then the maximum, sharing the width of the fields */
.database-filter-condition__range {
    flex-direction: row;
    align-items: center;
}

.database-filter-condition__limit {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 30px;
    margin-left: 0;
    margin-right: 0;
}

/* A limit that isn't a number, which is not applied. Red like the errors of the console, readable with both editor themes */
.database-filter-condition__limit--invalid > .unity-text-field__input {
    border-color: rgb(220, 70, 60);
}

.database-filter-condition__range-separator {
    -unity-text-align: middle-center;
    opacity: 0.7;
    padding-left: 3px;
    padding-right: 3px;
}

/* The chosen values of an enum, which can be long: aligned like a text, cut with an ellipsis */
.database-filter-condition__enum {
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-left: 0;
}

/* A reference: what it checks, then the asset, which takes the remaining width */
.database-filter-condition__reference {
    flex-direction: row;
    align-items: center;
}

.database-filter-condition__match {
    width: 84px;
    flex-shrink: 0;
    margin-left: 0;
}

.database-filter-condition__asset {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
    margin-left: 2px;
    margin-right: 0;
}

/* The folders of the scope (FolderScopeEditor), which is also the target of the folders dropped from the Project window. The border
   shows while folders are dragged over it */
.database-folder-scope {
    padding-top: 2px;
    padding-bottom: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.database-folder-scope--drag-over {
    border-color: rgb(58, 121, 187);
    background-color: rgba(58, 121, 187, 0.1);
}

.database-folder-scope__folder {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

/* Grows, so the remove button is on the right. The hand cursor says that a click pings the folder */
.database-folder-scope__path {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: link;
}

/* A folder that doesn't exist, ignored by the scope. Orange like the missing columns of the filters */
.database-folder-scope__path--missing {
    color: rgb(230, 150, 40);
    cursor: arrow;
}

.database-folder-scope__hint {
    -unity-font-style: italic;
    white-space: normal;
    opacity: 0.6;
    padding-top: 2px;
    padding-bottom: 2px;
}

.database-filter-editor__remove {
    flex-shrink: 0;
    padding-left: 1px;
    padding-right: 1px;
    margin-right: 0;
}

.database-filter-editor__remove > .sxp-icon {
    --sxp-icon-size: 14;
}

/* Shrinks beside the view panel instead of pushing it out of the window: the list views scroll horizontally */
.database-table-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 100px;
}

/* Holds the frozen list and the main list, side by side */
.database-table-view__body {
    flex-direction: row;
    flex-grow: 1;
}

.database-table-view__list {
    flex-grow: 1;
}

/* The width is set by FrozenColumnLink. The border marks the edge of the frozen column, and works with both editor themes */
.database-table-view__frozen-list {
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.4);
}

/* The message of an empty table and its Create Asset button take the place of the list, so the status line stays at the bottom */
.database-table-view__empty {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.database-table-view__empty-create {
    margin-top: 0;
}

/* The header of a column: the priority of the column in the sort, the icon of the sort, the icon of the filters, then the name
   (TableView.MakeHeader()) */
.database-table-view__header {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    overflow: hidden;
}

.database-table-view__header-label {
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    font-size: 13px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
}

.database-table-view__header-sort-icon {
    margin-right: 4px;
}

/* Shown only when several columns are sorted. Close to the icon it belongs to, smaller and fainter than the name */
.database-table-view__header-sort-priority {
    font-size: 10px;
    -unity-font-style: bold;
    opacity: 0.7;
    -unity-text-align: middle-left;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 1px;
}

/* Shown only on the headers of the columns that a condition of the filters uses. Faded, so it doesn't compete with the sort */
.database-table-view__header-filter-icon {
    margin-right: 4px;
    opacity: 0.8;
    --sxp-icon-size: 14;
}

/* Replaced by the icon of the header, which shows the sort beside the name instead of above it */
.database-table-view MultiColumnHeaderColumnSortIndicator {
    display: none;
}

/* The container of the display created by the cell handler. The vertical padding leaves the height of the editor's small controls
   (as the buttons of the Controls column) to the content of the rows, set by TableView.RowHeight */
.database-table-view__cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
}

/* The row of the other list when the pointer is over a row of the frozen list or of the main list, which are separate list views. Same
   color as the hover of Unity's list views, and two classes so it wins over the alternating row background */
.unity-collection-view__item.database-table-view__row--hover-mirror {
    background-color: var(--unity-colors-list_view_item-background-hover);
}

/* Holds the handle of a row and the cell of the first displayed column (TableView.WrapWithRowHandle()) */
.database-table-view__row-handle-container {
    flex-direction: row;
    flex-grow: 1;
}

/* The handle at the start of each row, which selects the whole row and shows its number. Its width is set by TableView, so the largest
   number fits. Translucent colors work with both editor themes. Temporary look, until the style pass */
.database-table-view__row-handle {
    flex-shrink: 0;
    justify-content: center;
    background-color: rgba(128, 128, 128, 0.15);
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.2);
}

.database-table-view__row-handle:hover {
    background-color: rgba(58, 121, 187, 0.5);
}

/* Small and faded, so the numbers don't draw attention. TableView.RowNumberDigitWidth depends on this font size */
.database-table-view__row-number {
    font-size: 9px;
    opacity: 0.6;
    -unity-text-align: middle-center;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
}

/* The cells of the rows whose assets are selected in Unity, while the selection sync is enabled. Lighter than the selection, which is
   drawn over it (declared after it) */
.database-table-view__cell--synced {
    background-color: rgba(58, 121, 187, 0.1);
}

/* The selected cells. The active cell is usually selected too, so a single click shows both styles. Temporary look, until the style
   pass */
.database-table-view__cell--selected {
    background-color: rgba(58, 121, 187, 0.25);
}

/* While Alt is held, the selected cells that an edit of the active cell would change (same type, in any column). Fainter than the
   outline of the active cell, declared before it so the active cell wins. The padding is reduced by the width of the border */
.database-table-view__cell--alt-target {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 3px;
    padding-right: 3px;
    border-width: 1px;
    border-color: rgba(58, 121, 187, 0.7);
}

/* The active cell has an outline only, so it can be told apart inside a selection. The padding is reduced by the width of the border,
   so its content doesn't move */
.database-table-view__cell--active {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 3px;
    padding-right: 3px;
    border-width: 1px;
    border-color: rgb(58, 121, 187);
}

/* Public class: CellHandler.EditFieldClass, also used by the custom handlers. The field fills the cell, which already has a padding */
.database-cell__edit-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

/* The edit field of [Range] (RangeCellHandler): a slider and a number field, or the number field alone in narrow cells. Two classes
   per selector, so they win over the class of the edit fields */
.database-cell__range {
    flex-direction: row;
    align-items: center;
}

.database-cell__range > .database-cell__range-slider {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
    margin-right: 0;
}

.database-cell__range > .database-cell__range-number {
    flex-grow: 0;
    flex-shrink: 0;
    width: 56px;
    margin-left: 4px;
}

.database-cell__range--compact > .database-cell__range-slider {
    display: none;
}

.database-cell__range--compact > .database-cell__range-number {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    margin-left: 0;
}

/* Public class: CellHandler.DisplayLabelClass, also used by the custom handlers */
.database-cell__label {
    -unity-text-align: middle-left;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
}

.database-cell__toggle {
    margin-left: 0;
    margin-right: 0;
}

/* A live control in a column that can't be edited (a computed column, TableView.SetLiveControlsReadOnly()): it ignores the pointer,
   and is faded so it doesn't look like it can be changed */
.database-cell__live-control--read-only {
    opacity: 0.6;
}

/* Holds the live dropdown of an enum, created when the first value is bound */
.database-cell__dropdown {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* The icon buttons of the Controls column (TableView.Controls), shrunk to fit the height of the rows */
.database-cell__controls {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.database-cell__control-button {
    height: 18px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 2px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 2px;
    padding-right: 2px;
}

/* Smaller than the default icon size, so the button keeps a margin inside the rows, which are smaller than the editor's lines */
.database-cell__control-button > .sxp-icon {
    --sxp-icon-size: 14;
}

.database-cell__swatch {
    flex-grow: 1;
    height: 14px;
    justify-content: flex-end;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.4);
}

.database-cell__swatch-alpha {
    height: 2px;
    background-color: white;
}

.database-cell__reference {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.database-cell__reference-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 2px;
}

.database-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

/* A button that shows a Tabler icon, alone or followed by a label (DatabaseElements.SetIcon()), toolbar buttons included */
.database-icon-button {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.database-icon-button__label {
    -unity-text-align: middle-left;
    margin-left: 2px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

/* A translucent border works with both the light and the dark editor themes. Tall enough for the page controls and the page size
   field, which keep the height of Unity's fields */
.database-status-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 22px;
    padding-left: 6px;
    padding-right: 6px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.3);
}

/* Shrinks with an ellipsis before the page controls in a narrow window */
.database-status-bar__label {
    -unity-text-align: middle-left;
    opacity: 0.8;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Pushes the page controls and the page size to the right */
.database-status-bar__spacer {
    flex-grow: 1;
}

/* The page controls (TableView.Pagination) */
.database-status-bar__pages {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 6px;
}

.database-status-bar__page-button {
    padding-left: 1px;
    padding-right: 1px;
    margin-left: 1px;
    margin-right: 1px;
    cursor: link;
}

.database-status-bar__page-button > .sxp-icon {
    --sxp-icon-size: 14;
}

.database-status-bar__page-text {
    -unity-text-align: middle-left;
    opacity: 0.8;
    padding-left: 3px;
    padding-right: 3px;
}

/* Room for four digits, the number of a page of a large table, or a page size */
.database-status-bar__page-field,
.database-status-bar__page-size {
    width: 40px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
}

.database-status-bar__page-field > .unity-base-field__input,
.database-status-bar__page-size > .unity-base-field__input {
    -unity-text-align: middle-center;
}

/* Apart from the page controls, since it's a setting of the view rather than a way to browse the pages */
.database-status-bar__page-size {
    margin-left: 8px;
}

/* The toolbar of both pages. Taller than Unity's toolbars, so its items get some room around them */
.database-toolbar {
    height: 28px;
    padding-left: 2px;
    padding-right: 2px;
}

/* Two classes, so they win over the styles of Unity's toolbar items */
.database-toolbar > .unity-toolbar-button {
    padding-left: 8px;
    padding-right: 8px;
    cursor: link;
}


/* The focused button keeps the borders of the other toolbar buttons instead of the blue focus border, and is marked by its
   background only, so the buttons can still be reached with the keyboard */
.database-toolbar > .unity-toolbar-button:focus {
    border-color: var(--unity-colors-toolbar_button-border);
    background-color: var(--unity-colors-toolbar_button-background-focus);
}

/* A toolbar button used as a toggle, while it's on (the selection sync): the background of Unity's checked toolbar toggles. It stays
   on hover and focus (and press, which is also a hover), so the state is always visible: declared after the focus style, with more
   classes than it and than the hover style of Unity */
.database-toolbar > .unity-toolbar-button.database-toolbar__button--checked,
.database-toolbar > .unity-toolbar-button.database-toolbar__button--checked:hover,
.database-toolbar > .unity-toolbar-button.database-toolbar__button--checked:focus {
    background-color: var(--unity-colors-toolbar_button-background-checked);
}

.database-toolbar > .database-toolbar__search,
.database-toolbar > .database-toolbar__row-search {
    margin-top: 4px;
    margin-bottom: 4px;
    margin-left: 6px;
    margin-right: 6px;
}

.database-toolbar__search {
    flex-grow: 1;
    width: auto;
}

/* The search of the rows shares the toolbar with the title and the buttons of the table, so it shrinks in narrow windows */
.database-toolbar__row-search {
    width: 240px;
    min-width: 80px;
    flex-shrink: 1;
}

/* Pushes the next toolbar items to the right */
.database-toolbar__spacer {
    flex-grow: 1;
}

.database-toolbar__title {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    font-size: 15px;
    margin-left: 8px;
    margin-right: 4px;
    padding-left: 0;
    padding-right: 0;
}

.database-obsolete-mark {
    -unity-text-align: middle-left;
    margin-left: 4px;
}

/* The button of the views, right of the search field (TablePage). It shrinks with the search field, and a long view name ends with
   an ellipsis */
.database-toolbar > .database-toolbar__view {
    flex-shrink: 1;
    min-width: 60px;
}

.database-toolbar__view > .database-icon-button__label {
    flex-shrink: 1;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Smaller than the icon of the view, like the arrows of Unity's dropdowns */
.database-toolbar__view > .database-toolbar__view-arrow {
    --sxp-icon-size: 12;
    flex-shrink: 0;
    margin-left: 2px;
    opacity: 0.7;
}

/* The name field of the View section of the view panel (ViewPanel) */
.database-view-panel__view-name {
    margin-left: 0;
    margin-right: 0;
}

.database-table-list {
    flex-grow: 1;
}

/* The height of the items is set by TableListPage. The hand cursor says that a single click opens the table or toggles the group.
   The item fills the content of the row of the tree view, after its indent and its arrow, so the whole row can be clicked */
.database-table-list__item {
    cursor: link;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    padding-right: 10px;
}

.database-table-list__icon {
    flex-shrink: 0;
    margin-right: 6px;
    opacity: 0.8;
}

.database-table-list__name {
    -unity-text-align: middle-left;
    font-size: 14px;
}

/* The groups are only used to navigate: their names are fainter than the tables */
.database-table-list__item--group > .database-table-list__name {
    opacity: 0.8;
}

.database-message {
    -unity-text-align: middle-center;
    white-space: normal;
    opacity: 0.6;
    margin: 12px;
}
